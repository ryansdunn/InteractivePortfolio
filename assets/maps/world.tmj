e":"dir","type":"string","value":"N"}]},{"id":7,"name":"sign3","type":"sign","x":736,"y":944,"width":16,"height":16,"visible":true,"rotation":0,"properties":[{"name":"text","type":"string","value":"someone is working just ahead…"},{"name":"dir","type":"string","value":"W"}]},{"id":8,"name":"sign4","type":"sign","x":1136,"y":1088,"width":16,"height":16,"visible":true,"rotation":0,"properties":[{"name":"text","type":"string","value":"the sound gets closer…"},{"name":"dir","type":"string","value":"SE"}]}]},{"id":6,"type":"objectgroup","name":"fragments","opacity":1,"visible":true,"objects":[{"id":9,"name":"fragment0","type":"fragment","x":416,"y":800,"width":16,"height":16,"visible":true,"rotation":0,"properties":[{"name":"title","type":"string","value":"an abandoned terminal"},{"name":"text","type":"string","value":"A dead screen, still warm. The last line of a commit hangs half-typed: \"almost—\". Whoever sat here believed the next try would be the one."}]},{"id":10,"name":"fragment1","type":"fragment","x":1344,"y":1344,"width":16,"height":16,"visible":true,"rotation":0,"properties":[{"name":"title","type":"string","value":"a cassette in the sand"},{"name":"text","type":"string","value":"Half-buried by the tide. The label, in faded marker: \"for when you forget.\" You can almost hear it."}]},{"id":11,"name":"fragment2","type":"fragment","x":992,"y":416,"width":16,"height":16,"visible":true,"rotation":0,"properties":[{"name":"title","type":"string","value":"a child's drawing, pinned to a post"},{"name":"text","type":"string","value":"A crayon sun over a tiny stick figure at a piano. Underneath, careful letters: \"el profe nos dejó cantar.\" (the teacher let us sing.)"}]},{"id":12,"name":"fragment3","type":"fragment","x":736,"y":1344,"width":16,"height":16,"visible":true,"rotation":0,"properties":[{"name":"title","type":"string","value":"a cairn of small stones"},{"name":"text","type":"string","value":"Someone stacked these, one at a time. A marker for a path, or just proof that they passed through and chose to leave something behind."}]}]}]}